# Hostinger (Apache/LiteSpeed) config for Elite Shine static site
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /index.html

RewriteEngine On

# Real domain: force https://www (only this domain, so Hostinger's
# temporary preview URL isn't sent to a www. address with no certificate)
RewriteCond %{HTTP_HOST} ^(www\.)?eliteshinecleaningservices\.net$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^eliteshinecleaningservices\.net$ [NC]
RewriteRule ^ https://www.eliteshinecleaningservices.net%{REQUEST_URI} [L,R=301]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/json
</IfModule>

# Caching: always revalidate HTML so updates show immediately
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
